# Genesis .gitignore

# Dependencies
node_modules/
.venv/
__pycache__/
*.egg-info/

# Development
.DS_Store
*.swp
*.swo
.env.local
.env.*.local

# Logs
*.log
logs/

# Build
dist/
build/
*.pyc

# Editor
.vscode/
.idea/
*.sublime-*

# Checkpoints (local only)
.claude/checkpoints/

# Per-repo config for third-party skill plugins (e.g. mattpocock-skills'
# setup-matt-pocock-skills output). Personal/local — regenerate by re-running
# the plugin's setup skill; not part of the public Genesis repo.
docs/agents/

# Temporary
tmp/
temp/
*.tmp
